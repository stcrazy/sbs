Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteBase /sbs/
RewriteRule ^(?:\.git|\.local|\.build|node_modules|src|tests|scripts|outputs|vendor)(?:/|$) - [F,L]
RewriteRule ^(?:package(?:-lock)?\.json|tsconfig\.json|vite\.config\.mjs|composer\.(?:json|lock)|app\.html|.*config.*\.php|\.env.*)$ - [F,L,NC]
RewriteRule ^api/(?:games|pool|auth|invite|push|requests|image(?:/[a-f0-9-]+)?)$ api/index.php [QSA,L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
